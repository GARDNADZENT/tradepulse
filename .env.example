# TradePulse — Environment Configuration
# Copy this file to .env and supply your registered Deriv OAuth credentials.

# Required for Deriv OAuth 2.0 + PKCE login & WebSocket market data
NEXT_PUBLIC_DERIV_APP_ID=1089
NEXT_PUBLIC_DERIV_APP_NAME=TradePulse
NEXT_PUBLIC_DERIV_ENV=
NEXT_PUBLIC_DERIV_REDIRECT_URI=
NEXT_PUBLIC_DERIV_REFERRAL_LINK=

# Optional: Supabase journey & connection status sync
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: Google Drive strategy storage
GD_CLIENT_ID=
GD_APP_ID=
GD_API_KEY=
