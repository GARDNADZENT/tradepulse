{
    "brand_name": "TradePulse",
    "brand_domain": "tradepulse.app",
    "brand_hostname": {
        "staging": "staging.tradepulse.app/dashboard",
        "production": "tradepulse.app/dashboard"
    },
    "domain_name": "tradepulse.app",
    "colors": {
        "primary": "#4F46E5",
        "secondary": "#475569",
        "tertiary": "#8B5CF6",
        "success": "#059669",
        "danger": "#E11D48",
        "warning": "#D97706",
        "info": "#0EA5E9",
        "neutral": "#64748B",
        "black": "#0F172A",
        "white": "#FFFFFF",
        "grey": {
            "50": "#f8fafc",
            "100": "#f1f5f9",
            "200": "#e2e8f0",
            "300": "#cbd5e1",
            "400": "#94a3b8",
            "500": "#64748b",
            "600": "#475569",
            "700": "#334155",
            "800": "#1e293b",
            "900": "#0f172a"
        }
    },
    "typography": {
        "font_family": {
            "primary": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
            "secondary": "'Inter', system-ui, sans-serif",
            "monospace": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [
            100,
            200,
            300,
            400,
            500
        ],
        "dark_variants": [
            600,
            700,
            800,
            900
        ],
        "opacity_variants": [
            10,
            20,
            30,
            40,
            50,
            60,
            70,
            80,
            90
        ]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "TradePulse",
        "tagline": "Plan. Track. Perform.",
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "tradepulse.app"
            },
            "staging": {
                "com": "staging.tradepulse.app"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
