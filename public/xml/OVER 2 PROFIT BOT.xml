<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="stake_id">stake</variable>
    <variable id="initial_stake_id">initial_stake</variable>
    <variable id="duration_id">duration</variable>
    <variable id="prediction_id">prediction</variable>
    <variable id="martingale_factor_id">martingale_factor</variable>
    <variable id="consecutive_losses_id">consecutive_losses</variable>
    <variable id="take_profit_id">take_profit</variable>
    <variable id="stop_loss_id">stop_loss</variable>
  </variables>
  <block type="trade_definition" id="trade_def_1" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_cfg" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <field name="ALTERNATE_MARKETS">FALSE</field>
        <field name="ALTERNATE_MODE">EVERY_X_RUNS</field>
        <field name="ALTERNATE_EVERY">1</field>
        <next>
          <block type="trade_definition_tradetype" id="trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITOVER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <field name="VH_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restart_on_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR" id="stake_id">stake</field>
        <value name="VALUE">
          <block type="math_number" id="stake_val">
            <field name="NUM">0.35</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_initial_stake">
            <field name="VAR" id="initial_stake_id">initial_stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_stake_for_init">
                <field name="VAR" id="stake_id">stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_martingale">
                <field name="VAR" id="martingale_factor_id">martingale_factor</field>
                <value name="VALUE">
                  <block type="math_number" id="martingale_val">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_tp">
                    <field name="VAR" id="take_profit_id">take_profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="tp_val">
                        <field name="NUM">25</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_sl">
                        <field name="VAR" id="stop_loss_id">stop_loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="sl_val">
                            <field name="NUM">500</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_prediction">
                            <field name="VAR" id="prediction_id">prediction</field>
                            <value name="VALUE">
                              <block type="math_number" id="pred_val">
                                <field name="NUM">2</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_duration">
                                <field name="VAR" id="duration_id">duration</field>
                                <value name="VALUE">
                                  <block type="math_number" id="duration_val">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_losses">
                                    <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="losses_val">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_options">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="TRADE_EACH_TICK">FALSE</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="dur_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="get_duration">
            <field name="VAR" id="duration_id">duration</field>
          </block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amt_shadow">
            <field name="NUM">0.35</field>
          </shadow>
          <block type="variables_get" id="get_stake">
            <field name="VAR" id="stake_id">stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="pred_shadow">
            <field name="NUM">2</field>
          </shadow>
          <block type="variables_get" id="get_prediction">
            <field name="VAR" id="prediction_id">prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="result_handler" x="1133" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="win_loss_check">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake">
            <field name="VAR" id="stake_id">stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_initial_stake">
                <field name="VAR" id="initial_stake_id">initial_stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_losses">
                <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                <value name="VALUE">
                  <block type="math_number" id="zero_losses">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="notify" id="win_notify">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">earned-money</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="win_msg_shadow">
                        <field name="TEXT">abc</field>
                      </shadow>
                      <block type="text" id="win_msg">
                        <field name="TEXT">Win! Stake reset to initial amount</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="martingale_stake">
            <field name="VAR" id="stake_id">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="calc_martingale">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="get_current_stake">
                    <field name="VAR" id="stake_id">stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_martingale_factor">
                    <field name="VAR" id="martingale_factor_id">martingale_factor</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="inc_losses">
                <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="add_loss">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="variables_get" id="get_losses">
                        <field name="VAR" id="consecutive_losses_id">consecutive_losses</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="one">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="notify" id="loss_notify">
                    <field name="NOTIFICATION_TYPE">warn</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="loss_msg_shadow">
                        <field name="TEXT">abc</field>
                      </shadow>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="tp_sl_check">
            <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="tp_compare">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="total_profit" id="tp_current"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_tp_target">
                    <field name="VAR" id="take_profit_id">take_profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="tp_notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">job-done</field>
                <value name="MESSAGE">
                  <shadow type="text" id="tp_msg_shadow">
                    <field name="TEXT">abc</field>
                  </shadow>
                  <block type="text" id="tp_msg">
                    <field name="TEXT">Take profit reached! Bot stopped.</field>
                  </block>
                </value>
                <next>
                  <block type="tp_block" id="trigger_tp"></block>
                </next>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="sl_compare">
                <field name="OP">LTE</field>
                <value name="A">
                  <block type="total_profit" id="sl_current"></block>
                </value>
                <value name="B">
                  <block type="math_single" id="negate_sl">
                    <field name="OP">NEG</field>
                    <value name="NUM">
                      <shadow type="math_number" id="sl_shadow">
                        <field name="NUM">9</field>
                      </shadow>
                      <block type="variables_get" id="get_sl_target">
                        <field name="VAR" id="stop_loss_id">stop_loss</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="notify" id="sl_notify">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">error</field>
                <value name="MESSAGE">
                  <shadow type="text" id="sl_msg_shadow">
                    <field name="TEXT">abc</field>
                  </shadow>
                  <block type="text" id="sl_msg">
                    <field name="TEXT">Stop loss reached! Bot stopped.</field>
                  </block>
                </value>
                <next>
                  <block type="sl_block" id="trigger_sl"></block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again" id="restart"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="buy_logic" deletable="false" x="0" y="1148">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="entry_check">
        <value name="IF0">
          <block type="logic_operation" id="digit_or_check">
            <field name="OP">OR</field>
            <value name="A">
              <block type="logic_operation" id="digit_or_1">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="logic_compare" id="check_digit_1">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="last_digit" id="ld_1"></block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="target_1">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="check_digit_3">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="last_digit" id="ld_2"></block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="target_3">
                        <field name="NUM">3</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="check_digit_5">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="last_digit" id="ld_3"></block>
                </value>
                <value name="B">
                  <block type="math_number" id="target_5">
                    <field name="NUM">5</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="trade_notify">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="trade_msg_shadow">
                <field name="TEXT">abc</field>
              </shadow>
            </value>
            <next>
              <block type="mon_purchase" id="buy_over">
                <field name="PURCHASE_LIST">DIGITOVER</field>
                <field name="MULTIPLE_CONTRACTS">FALSE</field>
                <field name="CONTRACT_QUANTITY">1</field>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <block type="text_join" id="trade_msg" x="0" y="1564">
    <field name="VARIABLE" id="GH,@h~d)TP4%ik![vpT=">text</field>
  </block>
  <block type="text_join" id="loss_msg" x="0" y="1612">
    <field name="VARIABLE" id="GH,@h~d)TP4%ik![vpT=">text</field>
  </block>
</xml>